# NEVER commit a PKI: private keys, generated certificates, packages
pki/
leafcerts/
*.key
*.pfx
*.p12
*.csr
*.certpacked
transport/
certpacked-received/
agantra-pki-devkit-*
agantra-pki-server-*.zip
agantra-pki-server-*.tar.gz
PKI-DevSecOps-*.zip
*.log
*.tmp
*.old
*:Zone.Identifier
external-ca/
csr-signed/
devkit.env
# Other companies' PKI profiles (New-PkiConfig.ps1) stay local; only the default agantra_pki.cnf is committed
*_pki.cnf
!agantra_pki.cnf

# Backups of the whole PKI (Backup-Pki.ps1): they hold private keys
backup-pki/
