# Native OpenSSL providers only. No ENGINE API, no oqsprovider.
openssl_conf = openssl_init
.include C:/Program Files/FireDaemon OpenSSL 4/bin/fipsmodule.cnf

[ openssl_init ]
providers = provider_sect

[ provider_sect ]
fips = fips_sect
base = base_sect

[ base_sect ]
activate = 1

