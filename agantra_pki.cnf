# ============================================================
# Agantra Inovatif PKI configuration  (agantra_pki.cnf)
#
# Project : Agantra Inovatif DevSecOps Small Project
# Company : Agantra Inovatif OU (NextMantra)
# Author  : Nicko Satria Utama
# Email   : nicko@nextmantra.com
#
# Replaces ev_pki.cnf. pki_setup.ps1 reads this file by default;
# pass -ConfigFile <path> to use another one.
#
# HOW IT IS USED
#   The PowerShell scripts read the sections below and WRITE a
#   separate OpenSSL configuration for every CA and every leaf. This
#   file is therefore never passed to OpenSSL directly, but it keeps
#   OpenSSL syntax so it stays editable and diff-friendly.
#
# PRECEDENCE   command-line parameter > this file > built-in default
#
# OpenSSL 4.x ONLY
#   * The ENGINE API is gone. Nothing here, and nothing the scripts
#     generate, uses "openssl engine" or OPENSSL_NO_ENGINE.
#   * All algorithms come from native providers (default, fips, base).
#     Third-party providers (oqsprovider) are not used.
#
# PRIVATE PKI
#   Trusted only on machines where the Enterprise Root CA is
#   installed. No browser shows the EV company line for a private root.
# ============================================================


# ============================================================
# GENERAL SETTINGS  (all optional; defaults shown)
# ============================================================
#
# Hierarchy and validity (years, from the moment of generation):
#   Enterprise Root 1000 -> Track Root 500 -> Quadrant Root 400
#   -> Intermediate 250 -> Leaf (days)
# Each level must be shorter than the level above it.
#
# Algorithms:
#   ROOT KEYS ARE FIXED BY POLICY and cannot be changed here:
#       Enterprise Root, Track Roots, Quadrant Roots
#         RSA      8192 bit    SHA-512     Enterprise Root, Classic Track Root
#         RSA      4096 bit    SHA-384     Classic Q1 Root  (QuadrantRsaBits 4096 | 8192)
#         ECDSA    P-384       SHA-384     Classic Q2 Root, FIPS, equal strength to Q1  (QuadrantCurve P-384 | P-521)
#         ML-DSA   ML-DSA-87   no digest   Quantum Track Root, Quantum Q1 (non-FIPS), Quantum Q2 (FIPS)
#   Below the roots (changeable):
#       IntermediatePathLen   0 (default) | 1: pathLenConstraint of the intermediates. 1 lets an intermediate sign another private CA.
#       IntermediateRsaBits   RSA size of the Q1 intermediates (4096 | 8192).
#       IntermediateCurve     EC curve of the Q2 intermediates (P-256 | P-384 | P-521).
#       PqcAlgorithm          ML-DSA parameter set of the Quantum (quadrant 3 / 4) intermediates (mldsa44 | 65 | 87).
#       PqcLeafAlgorithm      ML-DSA parameter set of the Quantum (quadrant 3 / 4) leaves (default mldsa65).
#       FallbackRsaBits       only used with -PqcFallback (see below): 4096 | 8192.
#
#   The whole Quantum track uses ML-DSA. If this OpenSSL cannot create an ML-DSA key the script
#   STOPS. Only the -PqcFallback switch lets it create an RSA key instead (not quantum-safe).
#   ML-DSA certificates: stored and validated by Windows 11 24H2+ / Server 2025 and OpenSSL 3.5+;
#   Windows TLS (Schannel) and the browsers do not accept them for HTTPS yet.
#
# Digests (signature on the CA certificates):
#   Enterprise + Track Roots SHA-512; Quadrant Roots SHA-384 (they sign the intermediates); ML-DSA signs without a digest
#   Intermediates + leaves  SHA-256 (RSA), SHA-384 (EC), none (ML-DSA)
# ============================================================

[ pki_settings ]

IntermediatePathLen = 0
QuadrantRsaBits     = 4096
QuadrantCurve       = P-384
IntermediateRsaBits = 4096
IntermediateCurve   = P-384
PqcAlgorithm        = mldsa87
PqcLeafAlgorithm    = mldsa65
FallbackRsaBits     = 8192

RootYears        = 1000
TrackYears       = 500
QuadrantYears    = 400
IntYears         = 250

# Leaf (end-entity) validity, used when no parameter is given:
#   EV  397 days  (-LeafDays, maximum 398)     OV  3 years     DV  5 years
LeafDays         = 397
OvLeafYears      = 3
DvLeafYears      = 5


# Organizational Unit per CA layer (names of the CAs themselves: section [ ca_names ] below)
OU_Root          = Root-Certs
OU_Track         = Track-Roots
OU_Quadrant      = Quadrant-Roots
OU_Intermediate  = Intermediate-CA

# Subject of the CA certificates (Root, Track, Quadrant, Intermediate)
Organization     = Agantra Inovatif OU
Country          = EE
State            = Tallinn
Locality         = Tallinn
CaSerialNumber   = EEARIREG.17344131
JurisdictionCountry = EE
CaContactName    = Nicko Satria Utama
CaContactEmail   = nicko@nextmantra.com
CaContactPhone   = (+372)53194019

# Certificate policy statement (CPS) put on the first policy
CpsUrl           = https://cps.nextmantra.com/ev_cps.pdf


# ============================================================
# CA NAMES  (common names and file-name stems of all roots and intermediates)
#
# The defaults live in scripts\01b_CaNaming.ps1. Everything below is OPTIONAL: remove the "#"
# of a line to change it. Tokens in a template:
#   {Prefix} {QuantumLabel} {Gen} {N} {Level} {Algorithm} {Track} {Id}
# A common name may not be longer than 64 characters and every CA needs a different one.
# Preview without generating:   .\pki_setup.ps1 -ShowNames
# ============================================================

[ ca_names ]

# Prefix         = Agantra Inovatif
# QuantumLabel   = PQC-PostQuantum
# SlugPrefix     = agantra
# GenEnterprise  = G1
# GenClassic     = G1
# GenQuantum     = G2

# EnterpriseRoot      = {Prefix} Enterprise Root CA {Gen}
# ClassicTrackRoot    = {Prefix} Enterprise Classic Root CA {Gen}
# QuantumTrackRoot    = {Prefix} Enterprise {QuantumLabel} Root CA {Gen}
# ClassicQuadrantRoot = {Prefix} Enterprise Classic Q{N} Root CA {Gen}
# QuantumQuadrantRoot = {Prefix} Enterprise {QuantumLabel} Q{N} Root CA {Gen}
# Intermediate        = {Prefix} {Level} {Algorithm} {Gen} CA


# ============================================================
# LEAF NAMES  (GenerateLeafCertificate.ps1)
#
# Where the leaf certificates are written and how they are called. Defaults are in
# scripts\01b_CaNaming.ps1; remove the "#" of a line to change it.
# Tokens: {Name} {Level} {Quadrant} {Tag} {Algorithm} {Track} {Fips} {Purpose} {PurposeName} {Date} {Time}
# If the folder of a leaf exists already, a NEW folder with the date and time is created
# (Folder + UniqueSuffix); nothing is ever overwritten.
# ============================================================

[ leaf_names ]

# OutputFolder  = leafcerts            (next to the scripts, NOT inside the pki folder; a full path is allowed)
# Folder        = {Name}
# Stem          = {Name}-{Level}-{Tag}
# UniqueSuffix  = _{Date}-{Time}
# PurposeFolder = {PurposeName}        (a set = one certificate per purpose: the folder of each purpose)
# PurposeStem   = {Name}-{Purpose}-{Level}-{Tag}


# ============================================================
# POLICY OIDs  (the EV policy is REQUIRED)
#
# What each certificate carries, so a client or an application can tell what it has:
#   Enterprise Root, Track Roots   All issuance policies (anyPolicy 2.5.29.32.0) + EV   (nothing else)
#   Quadrant Roots                 EV + OV + DV       (+ the PEN and [ custom_policies ] policies)
#   Intermediate                   its own level      (+ the PEN and custom policies of that level)
#   Leaf                           its own level      (+ PEN, custom, -Policy)
# Defaults are the CA/Browser Forum OIDs. Keep them unless your own applications look for
# a different value. EV, OV and DV must be different and valid OIDs.
# ============================================================

[ policy_oids ]

EV = 2.23.140.1.1
OV = 2.23.140.1.2.2
DV = 2.23.140.1.2.1


# ============================================================
# IANA PRIVATE ENTERPRISE NUMBER (PEN)  -  leave PEN blank until you have it
#
# Register at https://www.iana.org/assignments/enterprise-numbers
# When PEN is filled in (or -IanaPen is used), these policies are added to the Quadrant Roots, the
# Intermediates and ALL leaves. They are NOT added to the Enterprise Root and the Track Roots.
#     1.3.6.1.4.1.<PEN>.<PenPolicyArc>        company policy   (every Quadrant Root, Intermediate, leaf)
#     1.3.6.1.4.1.<PEN>.<PenPolicyArc>.1      EV level         (Quadrant Roots, EV intermediates, EV leaves)
#     1.3.6.1.4.1.<PEN>.<PenPolicyArc>.2      OV level         (Quadrant Roots, OV intermediates, OV leaves)
#     1.3.6.1.4.1.<PEN>.<PenPolicyArc>.3      DV level         (Quadrant Roots, DV intermediates, DV leaves)
# so your own applications can recognise a company EV certificate by its OID.
# ============================================================

[ iana_pen ]

# IANA Private Enterprise Number: 67096  (Agantra Inovatif OU, Nicko Satria Utama)
PEN           = 67096
PenPolicyArc  = 1


# ============================================================
# TIME STAMPING (RFC 3161)  -  the Time Stamping certificate of GenerateLeafCertificate.ps1
#
# The certificate is the normal leaf of purpose TimeStamping: extended key usage timeStamping, CRITICAL and alone (RFC 3161
# section 2.3). No special CA or profile is needed.
#   Quadrant    1 = Classic non-FIPS (default). 2 = Classic FIPS. 3 / 4 = Quantum (prepared; the PKI server kit does not sign
#               time stamps with ML-DSA yet). The other purposes of a leaf set keep the quadrant you chose with -Quantum / -FIPS.
#   PolicyOid   the time stamp policy OID: written into the TSA certificate and used by the time stamp server (tsa policy).
#               Blank: <PEN arc>.4  =  1.3.6.1.4.1.<PEN>.<PenPolicyArc>.4  (needs the IANA PEN above).
#   Days        validity of the TSA certificate. Longer than a TLS leaf (a time stamp must stay verifiable for years).
# Command line: -TimestampQuadrant -TimestampPolicyOid -TimestampDays
# ============================================================

[ timestamp ]

Quadrant   = 1
PolicyOid  =
Days       = 1825


# ============================================================
# REVOCATION: CRL and OCSP responder certificates (PkiRevocation.ps1, pki_setup.ps1)
#   CrlDays     validity of a CRL ("next update"). Make a new CRL before it ends: PkiRevocation.ps1 -Action NewCrl.
#   OcspDays    validity of an OCSP responder certificate.
#   OcspKeyBits RSA key size of an OCSP responder certificate.
# ============================================================

[ revocation ]

CrlDays      = 365
OcspDays     = 365
OcspKeyBits  = 2048


# ============================================================
# CUSTOM CERTIFICATE POLICIES  (optional)
#
# Every policy listed here is written where the PEN policies go: every Quadrant Root,
# Intermediate and leaf (GenerateLeafCertificate.ps1 can add more per leaf). The Enterprise
# Root and the Track Roots carry only All issuance policies + EV.
#
# Format:   <label> = <policy OID> [ | <CPS URL> ]
#
# For extra policies of your own (the [ iana_pen ] section above already adds the standard
# company policies once PEN is set):
#   1.3.6.1.4.1.<PEN>.<your numbers>
#
# Remove the leading "#" to enable. 99999 is a placeholder, NOT a real PEN.
# ============================================================

[ custom_policies ]

# CompanyPEN  = 1.3.6.1.4.1.99999.1 | https://cps.nextmantra.com/company-policy.pdf
# PersonalPEN = 1.3.6.1.4.1.99999.2


# ============================================================
# REVOCATION AND ISSUER LOCATIONS
#
# "{ca}" is replaced by the file name stem of the ISSUING CA, for
# example agantra-q1-ev-g1. pki_setup.ps1 writes the matching CRL and
# CA-issuer files to pki\publish\ - copy them to these hosts.
#
# Windows reports "revocation server offline" for client certificates
# until at least one URL answers (IIS / Kestrel mutual TLS).
# ============================================================

[ crl_urls ]

URI.1 = http://crl-01.nextmantra.com/{ca}.crl
URI.2 = http://crl-02.nextmantra.com/{ca}.crl
URI.3 = http://crl-dev.nextmantra.internal/{ca}.crl

[ ocsp_urls ]

URI.1 = http://ocsp.nextmantra.internal
URI.2 = http://ocsp.nextmantra.com

[ ca_issuer_urls ]

URI.1 = http://crt-01.nextmantra.com/{ca}.crt
URI.2 = http://crt-02.nextmantra.com/{ca}.crt
URI.3 = http://crt-dev.nextmantra.internal/{ca}.crt


# ============================================================
# LEAF SUBJECT ALTERNATIVE NAMES (default SAN set)
# Wildcards, localhost, IP addresses and e-mail addresses are allowed
# in this private PKI; the generators print a warning for wildcards.
# ============================================================

[ leaf_san ]

DNS.1 = nextmantra.com
DNS.2 = www.nextmantra.com
DNS.3 = localhost

IP.1 = 127.0.0.1

email.1 = nicko@nextmantra.com

# ============================================================
# DEVELOPMENT SAN  (GenerateLeafCertificate.ps1 -AddDevelopmentSAN)
# ============================================================
# Merged into the SAN of the TLS certificates (S/MIME gets the e-mail addresses only). For development: wildcards,
# IP addresses, internal names and e-mail addresses in one certificate are NOT EV-conformant, and that is intended.
# Keys: DNS.n   IP.n   IPRange.n = first-last (IPv4, at most 1024 addresses, every address is written)   email.n
# Remove the whole section to use the built-in list (the same as below).

[ development_san ]

DNS.1  = nextmantra.com
DNS.2  = www.nextmantra.com
DNS.3  = *.nextmantra.com
DNS.4  = localhost
DNS.5  = local.dev
DNS.6  = *.nextmantra.internal
DNS.7  = *.nextmantra.developer
DNS.8  = nextmantra.internal
DNS.9  = nextmantra.developer
DNS.10 = nextmantra.api
DNS.11 = *.nextmantra.api
DNS.12 = agantra.internal
DNS.13 = *.agantra.internal
DNS.14 = agantra.developer
DNS.15 = *.agantra.developer
DNS.16 = agantra.api
DNS.17 = *.agantra.api
DNS.18 = nextmantra.ldap
DNS.19 = *.nextmantra.ldap
DNS.20 = agantra.ldap
DNS.21 = *.agantra.ldap

IP.1 = 127.0.0.1
IP.2 = ::1
IP.3 = 10.10.2.2
IPRange.1 = 192.168.0.1-192.168.0.200
IPRange.2 = 172.16.0.1-172.16.0.200

email.1 = nicko@nextmantra.com
email.2 = robby@nextmantra.com
email.3 = info@nextmantra.com
email.4 = airlangga@nextmantra.com


# ============================================================
# LEAF SUBJECT FIELDS
#
# [ subject_ov ] is the base. [ subject_ev ] adds the EV fields on top.
# Anything missing falls back to the value shown here.
# CN empty = first DNS name of the SAN (or the Organization when the
# certificate has no DNS name).
# ============================================================

[ subject_ov ]

CN           =
O            = Agantra Inovatif OU
L            = Tallinn
ST           = Tallinn
C            = EE
postalCode   = 15199
ContactPhone = (+372)53194019
ContactName  = BizDevSecOps Administrator
ContactEmail = info@nextmantra.com

[ subject_ev ]

serialNumber                    = 17344131
businessCategory                = Private Organization
jurisdictionCountryName         = EE
jurisdictionStateOrProvinceName = Tallinn
DUNS                            =


# ============================================================
# [ person ]  defaults of GeneratePersonLeafCertificate.ps1 (a parameter or a file column wins)
#   EmailDomain         e-mail = <id code>@<EmailDomain> when none is given
#   Days                validity in days (730 = 2 years)
#   Level               DV | OV | EV (issuing intermediate)
#   CommonNameFormat    {Surname} {Given} {IdCode}; the CN is upper case, max 64 characters
#   Country, IdType     C= and the semantics identifier prefix (PNO personal number | PAS passport | IDC identity card | TIN tax number)
#   KeyType, Curve      ECDSA P-384 (default) or RSA (KeyBits 3072 minimum advised)
# ============================================================
[ person ]
EmailDomain      = eesti.ee
Days             = 730
Level            = OV
CommonNameFormat = {Surname},{Given},{IdCode}
Country          = EE
IdType           = PNO
KeyType          = ECDSA
Curve            = P-384


# ============================================================
# END OF CONFIGURATION
# ============================================================
