#!/usr/bin/env bash
# Author : Nicko Satria Utama   Company: Agantra Inovatif OU (NextMantra)   Email: nicko@nextmantra.com
# pre-commit: (1) every staged *.sh / *.py gets the execute bit in the index (so a clone on Linux can run it),
#             (2) refuses CRLF or a BOM in staged shell / python / config files, (3) refuses private keys.
# Install:  pwsh ./Setup-GitRepo.ps1     or     git config core.hooksPath .githooks     (linux/setup-git.sh does the same on Linux)
fail=0
while IFS= read -r f; do
  case "$f" in
    *.sh|*.py) git update-index --chmod=+x -- "$f" 2>/dev/null ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
while IFS= read -r f; do
  case "$f" in
    *.sh|*.py|*.cnf|*.json|*.pem|*.crt|*.pub|.githooks/*)
      blob="$(git show ":$f" 2>/dev/null)" || continue
      if printf '%s' "$blob" | grep -q $'\r'; then echo "pre-commit: CRLF in $f (convert: sed -i 's/\\r\$//' $f)"; fail=1; fi
      if [ "$(printf '%s' "$blob" | head -c3 | od -An -tx1 | tr -d ' ')" = efbbbf ]; then echo "pre-commit: BOM in $f"; fail=1; fi ;;
  esac
  case "$f" in
    *.key|*.pfx|*.p12) echo "pre-commit: private key file refused: $f"; fail=1 ;;
    *) if git show ":$f" 2>/dev/null | head -c 200000 | grep -Pzaq -- '-----BEGIN [A-Z ]*PRIVATE KEY-----\r?\n[A-Za-z0-9+/=]{40,}'; then echo "pre-commit: PRIVATE KEY text in $f - refused"; fail=1; fi ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
# (3b) 7.9.11: a .ps1 that may run in Windows PowerShell 5.1 (no "#requires -Version 7") must be pure ASCII: 5.1 reads a
#      file without BOM as ANSI, so a non-ASCII character becomes 2-3 other characters (a regex range like [x-y] breaks).
#      Write such characters as \uXXXX in a regex or [char]0xXXXX in code.
while IFS= read -r f; do
  case "$f" in
    Scripts/*) ;;      # the modules: loaded only by scripts that require PowerShell 7 (UTF-8 without BOM is read right)
    *.ps1|*.psm1)
      blob="$(git show ":$f" 2>/dev/null)" || continue
      printf '%s' "$blob" | head -40 | grep -qi '^#requires -version 7' && continue
      bad="$(printf '%s' "$blob" | LC_ALL=C grep -naP '[^\x00-\x7F]' | head -3)"
      if [ -n "$bad" ]; then echo "pre-commit: non-ASCII in $f (Windows PowerShell 5.1 misreads it; use \\uXXXX / [char]0xXXXX, or add #requires -Version 7):"; printf '%s\n' "$bad" | cut -c1-120; fail=1; fi ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
# (4) the html\ folder is made from docs\*.txt: rebuild it when a text document is newer, and stage the result
if command -v pwsh >/dev/null 2>&1 && [ -f Build-HtmlDocs.ps1 ]; then
  pwsh -NoProfile -File ./Build-HtmlDocs.ps1 -IfStale >/dev/null 2>&1 && git add -A html 2>/dev/null
fi
[ "$fail" = 0 ] || { echo "pre-commit: commit refused."; exit 1; }
exit 0
