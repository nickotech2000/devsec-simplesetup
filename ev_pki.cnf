# ============================================================
# OpenSSL Private PKI Configuration
#
# Project : MakananMurah / NextMantra
# Company : Agantra Inovatif OÜ
# Author  : Nicko Satria Utama
# Email   : nicko@nextmantra.com
#
# Purpose:
#   - Private Root CA
#   - Private Intermediate CA
#   - EV Leaf Certificates (TLS server + client authentication)
#   - Development / Internal PKI
#
# IMPORTANT:
#   This is a PRIVATE PKI configuration.
#   It is NOT a publicly trusted EV certificate profile.
#
#   The generated certificates are trusted only on systems where
#   the private Root CA has explicitly been installed.
#
#   Browsers (Chrome / Edge) only show the "Issued to: <company>"
#   line for EV certificates that chain to a root in the browser's
#   built-in EV list, so a private root can never trigger it. The
#   company name is always visible under "Show certificate".
#
# OpenSSL:
#   Compatible with OpenSSL 3.x / 4.x configuration syntax.
#
# EV rules enforced by the PowerShell generators:
#   - EV leaf EKU is exactly serverAuth + clientAuth
#   - certificatePolicies carries 2.23.140.1.1
#   - Subject has businessCategory, jurisdictionC, serialNumber,
#     C, L (or ST), O and CN
#   - Leaf validity is at most 398 days
#   - Defaults when a value is not supplied:
#       OU = BizDevSecOps, L = Tallinn, C = EE, jurisdictionC = EE
#
#   Other EKUs (codeSigning, emailProtection, ...) are NOT put in this
#   certificate. GenerateLeafCertificate.ps1 issues them as separate
#   certificates, one file set per EKU.
#
# ============================================================


# ============================================================
# OID REGISTRATION
# ============================================================

oid_section = new_oids


[ new_oids ]

# EV Certificate Policy OID
evPolicy = 2.23.140.1.1


# ============================================================
# CA DEFAULT CONFIGURATION
# ============================================================

[ CA_default ]

# Runtime PowerShell generator may replace this with an
# absolute path before invoking OpenSSL CA commands.
dir = ./pki

database = $dir/index.txt
new_certs_dir = $dir/issued

certificate = $dir/intermediate/intermediate.crt
private_key = $dir/intermediate/intermediate.key

serial = $dir/serial

default_md = sha256
default_days = 397

policy = policy_ev

unique_subject = no

copy_extensions = none
preserve = no

email_in_dn = no

utf8 = yes
string_mask = utf8only

name_opt = ca_default
cert_opt = ca_default


# ============================================================
# EV-STYLE CERTIFICATE POLICY
# ============================================================

[ policy_ev ]

countryName             = optional
stateOrProvinceName     = optional
localityName            = optional

organizationName        = optional
organizationalUnitName  = optional

commonName              = supplied

emailAddress            = optional

businessCategory        = optional
serialNumber            = optional

streetAddress           = optional
postalCode              = optional

jurisdictionCountryName = optional
jurisdictionStateOrProvinceName = optional
jurisdictionLocalityName = optional


# ============================================================
# CERTIFICATE REQUEST
# ============================================================

[ req ]

prompt = no

utf8 = yes

string_mask = utf8only

default_md = sha256

distinguished_name = dn


# ============================================================
# DEFAULT REQUEST SUBJECT
# ============================================================

[ dn ]

C  = EE
O  = Agantra Inovatif OU
CN = MakananMurah Private PKI


# ============================================================
# ROOT CA SUBJECT
# ============================================================
#
# Used by 04_CertificateAuthority.ps1 for the Root CA.
# Any field removed from this section falls back to the same
# value shown here.
#
# The three contact fields use the standard X.500 attributes
#   name            -> contact name
#   emailAddress    -> contact e-mail
#   telephoneNumber -> contact phone
# because a certificate subject cannot carry free-text labels.
# Remove them from the section if you ever need a strictly
# EV-conformant CA subject.
#
# ============================================================

[ dn_root_ev ]

jurisdictionCountryName = EE

serialNumber = EEARIREG.17344131

C = EE

L = Tallinn

O = Agantra Inovatif OU

OU = Root-Certs

CN = Agantra Inovatif Global Root G1

name = Nicko Satria Utama

emailAddress = nicko@nextmantra.com

telephoneNumber = (+372)53194019


# ============================================================
# INTERMEDIATE CA SUBJECT
# ============================================================

[ dn_intermediate_ev ]

jurisdictionCountryName = EE

serialNumber = EEARIREG.17344131

C = EE

L = Tallinn

O = Agantra Inovatif OU

OU = Intermediate-CA

CN = Agantra Inovatif EV RSA CA G1

name = Nicko Satria Utama

emailAddress = nicko@nextmantra.com

telephoneNumber = (+372)53194019


# ============================================================
# ROOT CA
# ============================================================

[ v3_root ]

basicConstraints = critical,CA:true,pathlen:1

keyUsage = critical,keyCertSign,cRLSign

subjectKeyIdentifier = hash

authorityKeyIdentifier = keyid:always


# ============================================================
# INTERMEDIATE CA
# ============================================================
#
# No extendedKeyUsage here on purpose: the same intermediate also
# signs the separate codeSigning / emailProtection / ... certificates
# made by GenerateLeafCertificate.ps1. An EKU on the CA would restrict
# every certificate below it to that EKU on Windows.
#
# ============================================================

[ v3_intermediate ]

basicConstraints = critical,CA:true,pathlen:0

keyUsage = critical,keyCertSign,cRLSign

subjectKeyIdentifier = hash

authorityKeyIdentifier = keyid:always

certificatePolicies = @ev_policy_ca


# ============================================================
# INTERMEDIATE CA POLICY
# ============================================================

[ ev_policy_ca ]

policyIdentifier = 2.23.140.1.1

CPS.1 = https://cps.nextmantra.com/ev_cps.pdf


# ============================================================
# EV LEAF CERTIFICATE (serverAuth + clientAuth)
# ============================================================
#
# IMPORTANT:
#
# Keep the extendedKeyUsage value on ONE PHYSICAL LINE.
# The PowerShell EV profile validator requires exactly
# serverAuth and clientAuth here. Any other EKU is rejected
# because an EV TLS certificate may not carry them.
#
# For RSA keys keyEncipherment is allowed. (The standalone
# GenerateLeafCertificate.ps1 drops it automatically for ECC.)
#
# ============================================================

[ v3_leaf ]

basicConstraints = critical,CA:false

keyUsage = critical,digitalSignature,keyEncipherment

extendedKeyUsage = serverAuth,clientAuth

subjectKeyIdentifier = hash

authorityKeyIdentifier = keyid,issuer

subjectAltName = @leaf_san

certificatePolicies = @ev_policy


# ============================================================
# EV LEAF CERTIFICATE POLICY
# ============================================================

[ ev_policy ]

policyIdentifier = 2.23.140.1.1

CPS.1 = https://cps.nextmantra.com/ev_cps.pdf


# ============================================================
# LEAF SUBJECT ALTERNATIVE NAMES
# ============================================================
#
# DNS names
# IP addresses
# Email addresses
#
# EV Guidelines allow only registered DNS names here (no wildcard).
# localhost, IP addresses and e-mail addresses are kept because this
# is a private PKI, but the generator prints a warning for them.
#
# ============================================================

[ leaf_san ]

DNS.1 = nextmantra.com
DNS.2 = www.nextmantra.com
DNS.3 = localhost

IP.1 = 127.0.0.1

email.1 = nicko@nextmantra.com
email.2 = airlangga@nextmantra.com
email.3 = robby@nextmantra.com
email.4 = mmb@makananmurah.com


# ============================================================
# EV-STYLE LEAF REQUEST SUBJECT
# ============================================================
#
# These fields are used when generating the leaf CSR.
#
# ============================================================

[ req_leaf_ev ]

prompt = no

utf8 = yes

string_mask = utf8only

default_md = sha256

distinguished_name = dn_leaf_ev


# ============================================================
# EV LEAF SUBJECT
# ============================================================
#
# Fields you leave out get these defaults:
#   OU = BizDevSecOps
#   L  = Tallinn
#   C  = EE
#   jurisdictionCountryName = EE
#
# Optional fields (add as needed):
#   ST, street, postalCode, jurisdictionStateOrProvinceName,
#   jurisdictionLocalityName
#
# ============================================================

[ dn_leaf_ev ]

businessCategory = Private Organization

jurisdictionCountryName = EE

serialNumber = 17344131

C = EE

L = Tallinn

O = Agantra Inovatif OU

# OU = BizDevSecOps

CN = nextmantra.com


# ============================================================
# END OF CONFIGURATION
# ============================================================
