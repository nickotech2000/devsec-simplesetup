{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PkiProxySettings": {
    "Mode": "full",
    "Routes": {
      "crl.nextmantra.internal": "crl.nextmantra.com",
      "ocsp.nextmantra.internal": "ocsp.nextmantra.com"
    },
    "Dns": {
      "Bind": "127.0.0.2:53",
      "Ttl": 60,
      "FromRoutes": true,
      "Names": {
        "crl.nextmantra.internal": "",
        "ocsp.nextmantra.internal": "",
        "crt.nextmantra.internal": "",
        "timestamp.nextmantra.internal": "",
        "tsa.nextmantra.internal": ""
      },
      "Upstream": []
    }
  }
}
